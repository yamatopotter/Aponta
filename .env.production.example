# Copie para .env.production e preencha antes de rodar docker-compose.prod.yml.
# Esse arquivo NUNCA deve ir pro git (já está no .gitignore).

# --- Banco de dados ---
# Só a senha — o compose já monta o resto da DATABASE_URL (usuário "evora",
# banco "evora_ponto", host "db"). Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=""

# --- Sessão / segurança ---
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
# Gere com: openssl rand -hex 32  (criptografa segredos do Zoho/RHiD em repouso)
APP_ENCRYPTION_KEY=""

# --- Integração RHiD ---
# Pode deixar em branco e configurar depois pela aba RHiD de
# /admin/configuracoes (fica salvo criptografado no banco) — estas variáveis
# são só o valor inicial/fallback.
RHID_API_BASE_URL="https://www.rhid.com.br/v2/api.svc"
RHID_INTEGRATION_EMAIL=""
RHID_INTEGRATION_PASSWORD=""

# --- Zoho OAuth ---
# Mesma lógica do RHiD acima: opcional aqui, dá pra configurar depois pela
# aba Zoho de /admin/configuracoes.
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
# Precisa ser a URL pública real de produção, não localhost.
ZOHO_REDIRECT_URI="https://SEU-DOMINIO/api/integrations/zoho/callback"

# --- Worker de sincronização ---
SYNC_INTERVAL_MINUTES=360
