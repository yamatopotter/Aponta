# Copie para .env.production e preencha antes de rodar docker-compose.prod.yml.
# Esse arquivo NUNCA deve ir pro git (já está no .gitignore).

# --- Banco de dados ---
# Só a senha — o compose já monta o resto da DATABASE_URL (usuário "evora",
# banco "evora_ponto", host "db"). Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=""

# --- Sessão / segurança ---
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
# Gere com: openssl rand -hex 32  (criptografa segredos do Zoho/RHiD em repouso)
APP_ENCRYPTION_KEY=""

# --- Integração RHiD ---
# Base URL e e-mail já vêm com valor padrão pelo banco (seed automático na
# 1ª migration). Pode deixar em branco e configurar/trocar depois pela aba
# RHiD de /admin/configuracoes (fica salvo criptografado no banco). Só a
# senha (secreta, sem padrão) precisa ser preenchida — aqui ou por lá.
RHID_INTEGRATION_PASSWORD=""

# --- Zoho OAuth ---
# Client ID/Secret são configurados pela aba Zoho de /admin/configuracoes
# (ficam salvos criptografados no banco) — não existe variável de ambiente
# para eles.
# Precisa ser a URL pública real de produção, não localhost.
ZOHO_REDIRECT_URI="https://SEU-DOMINIO/api/integrations/zoho/callback"

# --- Worker de sincronização ---
SYNC_INTERVAL_MINUTES=360
