# --- Banco de dados (nosso, não é o RHiD) ---
DATABASE_URL="postgresql://evora:evora@localhost:5432/evora_ponto?schema=public"

# --- Sessão / segurança ---
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-uma-string-aleatoria-de-32-bytes"
# Gere com: openssl rand -hex 32  (usado para criptografar segredos do Zoho em repouso)
APP_ENCRYPTION_KEY="troque-por-um-hex-de-64-caracteres"

# --- Integração RHiD (credencial de integração, NÃO é a de um funcionário) ---
# Peça ao suporte RHiD um usuário de integração dedicado, com permissão só de leitura
# sobre Person e Apuração de Ponto. Não use o login pessoal de um administrador do RHiD aqui.
# Base URL e e-mail já vêm com valor padrão pelo banco (seed da migration
# 20260803000000_seed_rhid_config_default) ou podem ser trocados em
# /admin/configuracoes (aba RHiD). Só a senha (secreta, sem padrão) precisa
# ser preenchida — aqui ou por lá.
RHID_INTEGRATION_PASSWORD=""

# --- Zoho OAuth (só usado pro login de admin via Zoho, não envia e-mail) ---
# Client ID/Secret são configurados pela aba Zoho de /admin/configuracoes
# (ficam salvos criptografados no banco) — não existe variável de ambiente
# para eles nem pro redirect_uri (é calculado a partir da própria requisição
# em src/lib/auth.ts, respeitando X-Forwarded-Host atrás de reverse proxy).

# --- Worker de sincronização (worker/sync-worker.ts) ---
# De quantos em quantos minutos ele repete empresas+departamentos+funcionários.
SYNC_INTERVAL_MINUTES=360
